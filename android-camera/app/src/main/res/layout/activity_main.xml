<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <TextView
        android:id="@+id/recIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:alpha="0"
        android:text="@string/rec_indicator"
        android:textColor="#E53935"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="#B0FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tapHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:alpha="0"
        android:text="@string/tap_hint"
        android:textColor="#80FFFFFF"
        android:textSize="14sp" />

    <!-- 設定パネル。上 (録画の開始・停止と状態) と下 (保存・閉じる) は常に見え、間の設定項目だけがスクロールする -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0101010"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/panelHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF1A1A1A"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_title"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#FFE57373"
                        android:textSize="15sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/recordButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="120dp"
                    android:minHeight="56dp"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/storageInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#B0FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/permissionButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_open_permissions"
                android:visibility="gone" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/panelScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/lastResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#FF9CCC65"
                    android:textSize="13sp"
                    android:textIsSelectable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/settings_note"
                    android:textColor="#B0FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    style="@style/SettingLabel"
                    android:text="@string/label_camera" />

                <TextView
                    android:id="@+id/cameraSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/chooseCameraButton"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_choose_camera" />

                <TextView
                    style="@style/SettingLabel"
                    android:text="@string/label_resolution" />

                <Spinner
                    android:id="@+id/resolutionSpinner"
                    style="@style/SettingSpinner" />

                <TextView
                    style="@style/SettingLabel"
                    android:text="@string/label_fps" />

                <Spinner
                    android:id="@+id/fpsSpinner"
                    style="@style/SettingSpinner" />

                <TextView
                    style="@style/SettingLabel"
                    android:text="@string/label_codec" />

                <Spinner
                    android:id="@+id/codecSpinner"
                    style="@style/SettingSpinner" />

                <TextView
                    style="@style/SettingLabel"
                    android:text="@string/label_bitrate" />

                <Spinner
                    android:id="@+id/bitrateSpinner"
                    style="@style/SettingSpinner" />

                <TextView
                    style="@style/SettingLabel"
                    android:text="@string/label_save_target" />

                <Spinner
                    android:id="@+id/saveSpinner"
                    style="@style/SettingSpinner" />

                <TextView
                    android:id="@+id/folderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B0FFFFFF"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/pickFolderButton"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_folder" />

                <Switch
                    android:id="@+id/audioSwitch"
                    style="@style/SettingSwitch"
                    android:text="@string/label_audio" />

                <Switch
                    android:id="@+id/stabilizationSwitch"
                    style="@style/SettingSwitch"
                    android:text="@string/label_stabilization" />

                <Switch
                    android:id="@+id/indicatorSwitch"
                    style="@style/SettingSwitch"
                    android:text="@string/label_indicator" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF1A1A1A"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/cancelButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/close" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/save" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
